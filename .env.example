# AERIS Lattice — Environment Configuration
# ─────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your API keys.
# Never commit .env to version control — it is listed in .gitignore.
#
# Required: OPENAI_API_KEY, GROQ_API_KEY, MISTRAL_API_KEY, GEMINI_API_KEY
# Optional: ANTHROPIC_API_KEY (reserved for future arbiter integration)
# ─────────────────────────────────────────────────────────────────────


# ── External consensus arbiters ───────────────────────────────────────

# OpenAI — https://platform.openai.com/api-keys
# Model: gpt-4o-mini
OPENAI_API_KEY=sk-...

# Groq — https://console.groq.com/keys (free tier available)
# Model: llama-3.3-70b-versatile
GROQ_API_KEY=gsk_...

# Mistral — https://console.mistral.ai/api-keys
# Model: mistral-small-latest
MISTRAL_API_KEY=...

# Google Gemini — https://aistudio.google.com/app/apikey
# Model: gemini-2.5-flash
GEMINI_API_KEY=AI...


# ── Optional arbiters ─────────────────────────────────────────────────

# Anthropic Claude — https://console.anthropic.com/settings/keys
# Reserved for future arbiter integration
ANTHROPIC_API_KEY=sk-ant-...


# ── Sovereign layer ───────────────────────────────────────────────────
# The sovereign layer uses Ollama running locally.
# No API key required — install Ollama and pull the model:
#
#   ollama pull llama3.2
#
# Ollama runs at http://localhost:11434 by default.
# Model name must match exactly what `ollama list` shows.
SOVEREIGN_MODEL=llama3.2:latest
SOVEREIGN_TIMEOUT=45


# ── Application configuration ─────────────────────────────────────────

# Confidence threshold for delivery (default: 70)
# Increase for stricter validation, decrease for more permissive delivery
CONFIDENCE_THRESHOLD=70

# Log file path (append-only decision audit log)
DECISION_LOG_PATH=decision_log.txt
